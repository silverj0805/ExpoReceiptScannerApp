{
  "expo": {
    "name": "모으곰(Mogom)",
    "slug": "mogom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/1024.png",
    "scheme": "exporeceiptscannerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.silverj0805.exporeceiptscannerapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.silverj0805.exporeceiptscannerapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#CFE9CE",
        "foregroundImage": "./assets/1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CFE9CE",
          "image": "./assets/1024.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증 사진을 선택하기 위해 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "영수증을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withGoogleServicePlistAtProjectRoot"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
