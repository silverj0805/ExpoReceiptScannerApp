# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# uniwind가 metro.config.js(withUniwindConfig)를 통해 dev 서버 기동 시마다 재생성하는
# 타입 파일 — 파일 자체가 "generated by uniwind, should not be edited manually"라고
# 명시함. 커밋해봐야 재생성될 때마다 포맷이 도로 흐트러져서 diff만 계속 생김.
src/uniwind-types.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# 실제 값이 든 .env는 커밋하지 않는다 — .env.example만 추적해서 어떤 키가 필요한지 남겨둔다.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

